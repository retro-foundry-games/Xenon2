; weapons: $4000-$5FFF (objects, weapons, pickups) and level 1's blob ($54E00 on)
type Object 98                                    ; an object (struct Object in types_weapons.h; play's Obj is the same record, less detailed)
type Slot 6                                       ; a weapon slot: type word, the object
var player_x_prev 0x4e4 uint16_t                         ; the player's x, one frame old
var player_y_prev 0x4e6 uint16_t
var trail_x 0x4e8 int16_t
var fire_press 0xa6a uint8_t
var l1_eyes_phase 0xd5a uint16_t
arr level_vars 0xd26 uint16_t 16                      ; level 1 boss state, cleared by the level's init
arr unit_seed 0xd46 uint32_t 5                      ; levels 1 to 3: the random state of each unit (rotated right by 5 for each pick)
arr unit_live 0xd86 uint8_t 5
var l1_boss_spawned 0xd8b uint8_t
var l1_boss_zone_entered 0xd8c uint8_t
var difficulty_x1 0x424 uint16_t
var difficulty_x2 0x426 uint16_t
tab weapon_slot_offsets 0x2404 int16_t 8                       ; x/y offsets of the four weapon slots
tab pickup_circle_steps 0x476c int16_t 16                      ; x/y steps of a pickup's eight-step circle
arr player_pictures 0x60d0 uint8_t * 13                     ; the player's pictures by player_vx + 6
arr dive_pictures 0x614a uint8_t * 4                      ; the player's pictures while dive_phase is 1..4
tab kill_scores 0x7970 uint16_t 2                      ; score added when a shot kills ($7972: when the pod shot does)
arr player_shot_pictures 0x27c2 uint8_t * 12                     ; pictures of the player's shots (three each)
tab anim_weaponb0 0x2540 uint8_t 6                   ; animation headers: picture (long), delay, then the script
tab anim_spinner 0x25a0 uint8_t 6
tab anim_weapon2c 0x25be uint8_t 6
tab anim_shell_9c 0x25e2 uint8_t 6
tab anim_weapon20 0x2612 uint8_t 6
tab anim_bonus_big 0x264e uint8_t 6
tab anim_bonus_small 0x26ae uint8_t 6
tab anim_explosion 0x270e uint8_t 6
tab anim_explosion_big 0x273a uint8_t 6
tab anim_player_death 0x2760 uint8_t 6
tab anim_weapon34 0x280a uint8_t 6
tab anim_weapon44 0x283a uint8_t 6
tab anim_weapon38 0x28b2 uint8_t 6
tab anim_weapon3c 0x28d0 uint8_t 6
tab anim_pod_decoration 0x28ee uint8_t 6
tab anim_drill_0 0x2912 uint8_t 6
tab anim_drill_1 0x2930 uint8_t 6
tab anim_drill_2 0x294e uint8_t 6
tab anim_drill_3 0x296c uint8_t 6
tab anim_drill_4 0x298a uint8_t 6
tab anim_drill_5 0x29a8 uint8_t 6
tab anim_drill_6 0x29c6 uint8_t 6
tab anim_drill_7 0x29e4 uint8_t 6
tab anim_weapon4c 0x2a02 uint8_t 6
tab anim_weapon90 0x2c24 uint8_t 6
var player_vx_prev 0x5dd0 int16_t                         ; a copy of player_vx the code area holds
tab weaponc0_picture 0x192ba uint8_t 2                    ; a picture
arr level_data_dst 0x7d120 uint8_t 12000
; --- code that never ran in the recorded run ---
tab anim_weaponb0_shot 0x2796 uint8_t 6
tab anim_weapon34_fire 0x27f2 uint8_t 6
tab anim_pod_trail 0x288e uint8_t 6
tab anim_drill_head_0 0x2918 uint8_t 6
tab pic_weapon34_idle 0x17336 uint8_t 2                   ; pictures of the pod ($34) the update tells apart
tab pic_weapon34_fire 0x171d6 uint8_t 2
tab pic_weapon90_twin 0x1838c uint8_t 2                   ; and of the twin gun ($90)
tab pic_weapon90_idle 0x182dc uint8_t 2
tab weapon2c_patterns 0x3d66 int16_t 99                      ; shot patterns of weapon $2C: count - 1, then (dx, dy, speed x, speed y) of each shot; three tables of 17, 33 and 49 words
tab weapon_damage 0x7966 uint16_t 4               ; damage: $7966 bomb pieces, $7968 beam of weapon $4C, $796A the pod's trail, $796C
tab blast_damage 0x7974 uint16_t 3                ; $7974 per level of the $34 beam, $7976 the shell, $7978 the blast of weapon $38/$3C
var area_damage_kept 0x30dc uint16_t                        ; the damage $3096 keeps while it calls the hit routines
var piece_directions 0xf60 int8_t *                         ; table of the pieces' directions (two bytes each, 64 apart)
var explosion_anim_f70 0xf70 uint8_t *                    ; an explosion's animation header (level 3's part bursts)
var big_explosion_anim 0xf64 uint8_t *                        ; the big explosion's animation header
tab anim_drill_head_1 0x2936 uint8_t 6
tab anim_drill_head_2 0x2954 uint8_t 6
tab anim_drill_head_3 0x2972 uint8_t 6
tab anim_drill_head_4 0x2990 uint8_t 6
tab anim_drill_head_5 0x29ae uint8_t 6
tab anim_drill_head_6 0x29cc uint8_t 6
tab anim_drill_head_7 0x29ea uint8_t 6
tab drill_dy 0x3ac2 int16_t 8                     ; step of a drill bit by direction
tab drill_dx 0x3ad2 int16_t 8
arr beam_state 0x6480 uint16_t 4                  ; the beam being drawn: x, y, length, level ($6480..$6486)
arr beam_heads 0x6488 uint8_t * 3                 ; the pictures of the beam's head by level
arr beam_bodies 0x6494 uint8_t * 3                ; the pictures of its tip
tab beam_pattern 0x663a uint32_t 15               ; by level: the mask and the four planes of the beam's slice (a long each, shifted by x & 15)
var trail_y 0x4ea uint16_t
blob level1_data 0x54e40 Level1Data                    ; the level's blob (blobs/levelN.blob): level 1's, then those of levels 2 to 5 over it
blob level2_data 0x54e40 Level2Data
blob level3_data 0x54e40 Level3Data
blob level4_data 0x54e40 Level4Data
blob level5_data 0x54e40 Level5Data
blob shop_data 0x54e40 ShopData                     ; the shop's blob (blobs/shop.blob)
