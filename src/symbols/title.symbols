; title: the title / credits screen ($7000-$87FF)
type Star 6
arr stars 0x42fdc Star 48                 ; starfield records
arr palette_saved 0x9640 uint16_t 16      ; copy of palette_shadow made while the title runs
var title_text 0x7dd6 const uint8_t *           ; the line of text being shown
var title_scale 0x7dda uint16_t           ; squeeze step of the text, 0..16
var title_y 0x7ddc int16_t                ; text row
var title_phase 0x7dde uint16_t           ; line counter within a page (0..2)
var title_index 0x7de0 uint16_t           ; byte offset into the step table
tab title_steps 0x833a uint16_t 21        ; scale steps of the credits page, 0 waits, -1 ends the line
tab title_script 0x8364 uint16_t 75       ; scale steps of the intro text (0x11 holds, -1 ends)
var title_rows 0x8422 uint16_t            ; y parameter of show_text_sequence
var title_steps_ptr 0x8424 uint16_t *     ; the step table in use
tab star_colors 0x8614 uint8_t 8          ; bit mask of the planes a star is drawn in, by depth
tab title_palette 0x86b2 uint16_t 16
tab title_font_chars 0x86d2 uint8_t 42   ; the characters of the title font, zero-terminated (the second list is text_chars)
tab squeeze_masks 0x8724 uint16_t 17      ; columns kept by the squeeze, by scale
tab title_lines 0x8746 uint8_t 240        ; credits text, 20 characters a line, two lines a page
tab title_font 0x9a36 uint16_t 3608       ; 22 rows of 4 plane words for each character
tab title_gfx 0xc966 uint16_t 2808        ; the logo, 54 rows of 13 words by 4 planes
var music_flag_1a584 0x1a584 uint8_t   ; set to 0x3f by the title
