# Xenon 2, the browser build of the SDL port (WebAssembly, Emscripten): the same program as the desktop one (Makefile, `make sdl`), the machine around it the browser's.
#
#   make -f Makefile.web          build build/web/xenon2.html, xenon2.js, xenon2.wasm
#   make -f Makefile.web serve    the folder is served on http://localhost:8080/ (scripts/serve_web.py)
#   make -f Makefile.web clean
#
# The game runs on the browser's thread: where it waits for the next frame (host_frame_end) the stack is parked (Asyncify, emscripten_sleep) and the browser runs.
# The disk images are not in the build: the page asks for them (web/shell.html).
# Run inside the flake's shell (nix develop): it has emcc, cmake and ninja; XENON2_SDL3_SOURCE_DIR is SDL3's source, built here for Emscripten once.
# `nix build .#web` does the same in the sandbox (XENON2_NO_NIX=1: no shell of its own; SDL3_PREFIX: the SDL3 the flake built for Emscripten; W: the output folder).

HERE := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SRC  := $(HERE)/src
W    ?= $(HERE)/build/web
PYTHON ?= python3
EMCC ?= emcc
SDL3_SRC ?= $(XENON2_SDL3_SOURCE_DIR)
SDL3_PREFIX ?= $(W)/sdl3

ifeq ($(or $(IN_NIX_SHELL),$(XENON2_NO_NIX)),)
.PHONY: all $(MAKECMDGOALS)
all $(MAKECMDGOALS):
	@nix develop $(HERE) --command $(MAKE) --no-print-directory -f $(lastword $(MAKEFILE_LIST)) $@
else

COMMON := -std=gnu11 -O2 -fno-strict-aliasing -Wall -Wno-unused-function -I$(SRC) -I$(SRC)/sdl -I$(SDL3_PREFIX)/include
GAME_CFLAGS := $(COMMON) -fpack-struct=2 -DGAME_SDL -DMATCH_MEMORY_LAYOUT
HOST_CFLAGS := $(COMMON) -DGAME_SDL -DMATCH_MEMORY_LAYOUT   # (SDL's headers must not be packed: main.c)

GAME_MODULES := $(filter-out runtime data,$(notdir $(basename $(wildcard $(SRC)/*.c))))
HOST_MODULES := $(filter-out main,$(notdir $(basename $(wildcard $(SRC)/sdl/*.c))))
OBJS := $(GAME_MODULES:%=$(W)/g_%.o) $(HOST_MODULES:%=$(W)/h_%.o) $(W)/h_main.o

.PHONY: all serve clean
all: $(W)/xenon2.html

$(W):
	mkdir -p $@

# SDL3 for Emscripten, once
$(SDL3_PREFIX)/lib/libSDL3.a: | $(W)
	emcmake cmake -S $(SDL3_SRC) -B $(W)/sdl3-build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$(SDL3_PREFIX) \
	    -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST_LIBRARY=OFF -DSDL_TESTS=OFF -DSDL_INSTALL=ON
	cmake --build $(W)/sdl3-build
	cmake --install $(W)/sdl3-build

$(W)/g_%.o: $(SRC)/%.c $(wildcard $(SRC)/*.h $(SRC)/sdl/*.h $(SRC)/amiga/*.h) $(SDL3_PREFIX)/lib/libSDL3.a | $(W)
	$(EMCC) $(GAME_CFLAGS) -MMD -MP -c $< -o $@
$(W)/h_%.o: $(SRC)/sdl/%.c $(wildcard $(SRC)/*.h $(SRC)/sdl/*.h $(SRC)/amiga/*.h) $(SDL3_PREFIX)/lib/libSDL3.a | $(W)
	$(EMCC) $(GAME_CFLAGS) -MMD -MP -c $< -o $@
$(W)/h_main.o: $(SRC)/sdl/main.c $(wildcard $(SRC)/*.h $(SRC)/sdl/*.h $(SRC)/amiga/*.h) $(SDL3_PREFIX)/lib/libSDL3.a | $(W)
	$(EMCC) $(HOST_CFLAGS) -MMD -MP -c $< -o $@

LINK := -sASYNCIFY -sINITIAL_MEMORY=33554432 -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sENVIRONMENT=web -sFORCE_FILESYSTEM=1 -sINVOKE_RUN=0 \
        "-sEXPORTED_RUNTIME_METHODS=['FS','callMain']" --shell-file=$(HERE)/web/shell.html

$(W)/xenon2.html: $(OBJS) $(HERE)/web/shell.html $(HERE)/web/retro-foundry.png
	$(EMCC) $(LINK) -o $@ $(OBJS) -L$(SDL3_PREFIX)/lib -lSDL3 -lm
	cp $(HERE)/web/retro-foundry.png $(W)/

serve: $(W)/xenon2.html
	$(PYTHON) $(HERE)/scripts/serve_web.py $(W)

clean:
	rm -rf $(W)

-include $(W)/*.d
endif
