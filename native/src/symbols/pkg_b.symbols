; pkg_b: $1800-$27FF and the start-up flow of $400 (init, main loop, vertical-blank interrupt)
arr exc_vectors_lo 0x8 irq_fn 23                   ; exception vectors $08..$63 (all point at game_entry)
arr exc_vectors_hi 0x80 irq_fn 224                 ; vectors $80..$3FF
var v_0404 0x404 uint16_t                          ; vbl_count at the last screen flip
var show_screen 0x40a uint8_t *                    ; the screen being shown
var v_0410 0x410 uint16_t                          ; minimum vertical blanks per frame (4 on 50 Hz, 5)
var v_0416 0x416 int16_t
var v_0418 0x418 int16_t                           ; pending sound command (-1 none), second slot
var v_041a 0x41a int16_t
var vbl_count 0x41c volatile uint16_t              ; counts the vertical blank interrupt (twice each)
var v_041e 0x41e uint16_t
var v_045c 0x45c uint16_t
var v_045e 0x45e uint16_t
var v_09fa 0x9fa uint16_t
var v_09fc 0x9fc uint8_t                           ; non-zero: music enabled
var v_09fd 0x9fd uint8_t
var v_09fe 0x9fe uint8_t
var key_code 0x9ff volatile uint8_t                ; the last key from the keyboard interrupt (0 = none)
var v_0ce8 0xce8 uint16_t
tab star_speed 0x22b6 uint16_t 18                  ; starfield scroll step, by the scroll speed: the table starts at $22B8 (index 1 here); the word before it is the step for scroll speed -1
var irq_div 0x208c uint16_t                        ; the vblank handler with hook runs the hook every third time
var irq_joy 0x208e uint8_t                         ; joystick bits read in the interrupt: 7 fire, 3 right, 2 left, 1 down, 0 up
var irq_joy_prev 0x208f uint8_t
var music_tick_fn 0x2090 irq_fn                    ; music player tick, called every vertical blank
var music_cmd_fn 0x2094 irq_fn                     ; music player command, d0.w = command
var copper_cur 0x700e uint16_t *                   ; the copper list in use (copper_list_a or copper_list_b)
tab key_table 0x7954 uint32_t 4                    ; key code << 24 | handler address; the last entry (code 0) matches every key
var v_8c41 0x8c41 uint8_t                          ; level digit in the loading text
var v_8f94 0x8f94 uint16_t
var v_8f96 0x8f96 uint16_t
var v_8fec 0x8fec uint8_t
arr v_884a 0x884a uint8_t 20                       ; "GAME OVER" text
var v_54e3c 0x54e3c uint16_t
var v_54e3e 0x54e3e uint16_t
