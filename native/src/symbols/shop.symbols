; shop: the shop (its variables below the blob; the blob itself is raw memory, see shop.c)
var shop_door_left 0x04ec uint16_t                         ; the doorway's left pillar (slides in steps of 4 between $30 and 0; bit 2 selects its picture)
var shop_door_right 0x04ee uint16_t                         ; the doorway's right pillar ($44 .. 0)
var shop_keeper_talking 0x04f0 uint8_t                          ; $FF while the keeper talks (the lower row of the room is redrawn at random)
var shop_keeper_aux 0x04f1 uint8_t       ; cleared with shop_keeper_talking, never read
var shop_cursor_col 0x04f2 uint16_t                         ; the cursor's column (0-4) in the grid; below the grid: 0 leave, 1 go on
var shop_cursor_row 0x04f4 uint16_t                         ; the cursor's row (0-3, 4 = the buttons)
var text_x 0x04f6 uint16_t                         ; the text's position: x in half bytes
var text_y 0x04f8 uint16_t                         ; the text's y
